# Server
PORT=4000
HOST=0.0.0.0
# Public URL of this API. Used to build metadata and proof URIs stored on chain.
PUBLIC_BASE_URL=http://localhost:4000
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Database (npm run dev:db starts a local Postgres on this URL)
DATABASE_URL=postgres://aidline:aidline@localhost:5433/aidline

# Stellar
AIDLINE_NETWORK=testnet
AIDLINE_RPC_URL=https://soroban-testnet.stellar.org
AIDLINE_CONTRACT_ID=
AIDLINE_TOKEN_ID=
# Ledger to start indexing from on first run (the deploy ledger is ideal)
INDEXER_START_LEDGER=
INDEXER_POLL_MS=5000
INDEXER_ENABLED=true

# Serve Prometheus metrics at GET /metrics
METRICS_ENABLED=true

# Admin wallet allowed to list pending verifier applications (G... address).
# Leave empty to disable the admin endpoint.
ADMIN_WALLET_ADDRESS=

# Keeper: funded Stellar secret used only to extend campaign storage TTLs.
# Never commit a real key; use a testnet account. Leave empty to disable.
AIDLINE_KEEPER_SECRET=
# Must match the contract's configured campaign TTL, in ledgers.
CAMPAIGN_TTL_LEDGERS=172800
# Bump when this many ledgers remain before expiry.
KEEPER_TTL_THRESHOLD_LEDGERS=7200
# How often to sweep for campaigns near expiry (ms, minimum 60000).
KEEPER_INTERVAL_MS=3600000

# Uploads
UPLOAD_DIR=uploads
